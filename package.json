{
  "name": "arcana-vox",
  "productName": "詠唱迷宮 ARCANA VOX",
  "version": "0.4.0",
  "description": "声で呪文を唱えるダンジョン探索ゲーム",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.cjs tests/*.test.mjs",
    "start": "electron .",
    "server": "node server.js",
    "setup-voice": "node tools/fetch-voice-model.js",
    "dist": "electron-builder --win portable --publish never",
    "build-web": "node tools/build-web.js",
    "predist": "node tools/vendor.js",
    "dist:steam": "electron-builder --win dir --publish never",
    "predist:steam": "node tools/vendor.js"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.7.6",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8",
    "vosk-browser": "^0.0.8"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "three": "^0.160.0",
    "trystero": "^0.26.0"
  },
  "build": {
    "appId": "com.arcanavox.game",
    "productName": "ArcanaVox",
    "copyright": "ARCANA VOX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "public/**",
      "vendor/**",
      "server.js",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "ArcanaVox-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "portable": {
      "unpackDirName": "ArcanaVox"
    }
  }
}
